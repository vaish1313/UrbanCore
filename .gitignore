__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
.venv/
env/
.env

# Node
node_modules/
dist/
.npm/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

