# Application
APP_NAME=UrbanCore
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=True
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://ttrarpuojnrmxcsftqph.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_-ul2QjiFjntgXkp6doa-rA_kdbJ7U2Y
SUPABASE_PROJECT_ID=ttrarpuojnrmxcsftqph

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urbancore
POSTGRES_USER=urbancore_user
POSTGRES_PASSWORD=your-secure-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=urbancore-storage
S3_ENDPOINT_URL=https://s3.amazonaws.com

# Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=urbancore-backend@final-year-project-501711.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee_key.json
GOOGLE_DRIVE_FOLDER_NAME=UrbanCore_Data
GOOGLE_DRIVE_FOLDER_ID=18nZsT7n6xm50pJ_Fl8R9K3eFejflvMwm

# Google Cloud Storage
GCS_BUCKET_NAME=urbancore-satellite-imagery
GCS_PROJECT_ID=final-year-project-501711

# Sentinel Hub (alternative to GEE)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@urbancore.com
FROM_NAME=UrbanCore

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# AI Model
MODEL_PATH=./outputs/best_unet_urbancore.pth
SAM_CHECKPOINT_PATH=/app/ai/checkpoints/sam_vit_h_4b8939.pth
UNET_CHECKPOINT_PATH=./outputs/urbancore_unet_v1.pth
ENABLE_SAM=true
SAM_3D_MODEL=facebook/sam-3d-body-dinov3
HF_TOKEN=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
DEVICE=cpu
BATCH_SIZE=8
NUM_WORKERS=4

# Training
TRAIN_DATA_PATH=/data/training
VAL_DATA_PATH=/data/validation
TEST_DATA_PATH=/data/test
TENSORBOARD_LOG_DIR=/logs/tensorboard
CHECKPOINT_DIR=/app/ai/checkpoints

# Processing
TEMP_DIR=/tmp/urbancore
MAX_UPLOAD_SIZE=100000000
ALLOWED_EXTENSIONS=.tif,.tiff,.geojson,.shp,.zip

# Monitoring
PROMETHEUS_PORT=9090
FLOWER_PORT=5555

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,https://urbancore.com
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/logs/urbancore.log
